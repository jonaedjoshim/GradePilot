{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/academic/:path*",
      "destination": "/api/academic"
    },
    {
      "source": "/((?!api(?:/|$)|assets/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
